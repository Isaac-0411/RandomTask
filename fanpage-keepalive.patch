+"""Behavioral checks for API throttling and public health-check exemptions."""
+
+import os
+import unittest
+from unittest.mock import patch
+
+from sqlalchemy import event
+
+# Never let a developer's DATABASE_URL select a real database during imports.
+with patch.dict(os.environ, {"DATABASE_URL": "sqlite:///:memory:"}):
+    from fanpage import create_app
+    from fanpage.config import Config
+    from fanpage.extensions import db
+    from fanpage.models import Image
+    from fanpage.rate_limits import client_ip
+
+
+class RateLimitTests(unittest.TestCase):
+    def setUp(self):
+        self.make_app()
+
+    def make_app(self, **overrides):
+        if hasattr(self, "app"):
+            self.close_app()
+        settings = {
+            "TESTING": True,
+            "ADMIN_PASSWORD": "test-admin-password",
+            "SQLALCHEMY_DATABASE_URI": "sqlite:///:memory:",
+            "SQLALCHEMY_ENGINE_OPTIONS": {},
+            "RATELIMIT_ENABLED": True,
+            "RATELIMIT_STORAGE_URI": "memory://",
+            "RATELIMIT_APPLICATION": "3 per minute",
+            "RATELIMIT_API_WRITES": "2 per minute",
+            "RATELIMIT_ADMIN_VERIFY": "2 per minute",
+            "RATELIMIT_HEADERS_ENABLED": True,
+            "RATELIMIT_HEADER_RETRY_AFTER_VALUE": "delta-seconds",
+            "RATELIMIT_TRUST_CLOUDFLARE": False,
+        }
+        settings.update(overrides)
+        config = type("RateLimitTestConfig", (Config,), settings)
+        self.app = create_app(config)
+        self.client = self.app.test_client()
+
+    def close_app(self):
+        with self.app.app_context():
+            db.session.remove()
+            db.engine.dispose()
+
+    def tearDown(self):
+        self.close_app()
+
+    def exhaust_api(self, **kwargs):
+        for _ in range(3):
+            self.assertEqual(self.client.get("/api/folders", **kwargs).status_code, 200)
+        response = self.client.get("/api/folders", **kwargs)
+        self.assertEqual(response.status_code, 429)
+        return response
+
+    def test_application_limit_returns_json_and_retry_headers(self):
+        response = self.exhaust_api()
+        self.assertEqual(
+            response.json,
+            {"error": "Too many requests. Please try again later."},
+        )
+        self.assertEqual(response.headers["X-RateLimit-Remaining"], "0")
+        self.assertEqual(response.headers["X-RateLimit-Limit"], "3")
+        retry_after = int(response.headers["Retry-After"])
+        self.assertGreaterEqual(retry_after, 1)
+        self.assertLessEqual(retry_after, 61)
+
+    def test_application_budget_is_shared_across_api_endpoints(self):
+        self.assertEqual(self.client.get("/api/folders").status_code, 200)
+        self.assertEqual(self.client.post("/api/admin/verify").status_code, 401)
+        self.assertEqual(self.client.patch("/api/folders/missing").status_code, 401)
+        self.assertEqual(self.client.get("/api/folders").status_code, 429)
+
+    def test_different_client_addresses_have_independent_budgets(self):
+        self.exhaust_api(environ_overrides={"REMOTE_ADDR": "198.51.100.1"})
+        response = self.client.get(
+            "/api/folders", environ_overrides={"REMOTE_ADDR": "198.51.100.2"}
+        )
+        self.assertEqual(response.status_code, 200)
+
+    def test_forwarded_headers_cannot_evade_limits_when_not_trusted(self):
+        self.exhaust_api(environ_overrides={"REMOTE_ADDR": "198.51.100.1"})
+        for forwarded_ip in ("203.0.113.1", "203.0.113.2"):
+            response = self.client.get(
+                "/api/folders",
+                environ_overrides={"REMOTE_ADDR": "198.51.100.1"},
+                headers={
+                    "X-Forwarded-For": forwarded_ip,
+                    "CF-Connecting-IP": forwarded_ip,
+                },
+            )
+            self.assertEqual(response.status_code, 429)
+
+    def test_mutations_share_a_limit_across_methods_and_blueprints(self):
+        self.make_app(RATELIMIT_APPLICATION="100 per minute")
+        self.assertEqual(self.client.post("/api/folders").status_code, 401)
+        self.assertEqual(
+            self.client.delete("/api/folders/one/videos/two").status_code, 401
+        )
+        self.assertEqual(self.client.patch("/api/folders/three").status_code, 429)
+        self.assertEqual(self.client.get("/api/folders").status_code, 200)
+
+    def test_failed_admin_attempts_are_counted_even_if_key_changes(self):
+        self.make_app(RATELIMIT_APPLICATION="100 per minute")
+        for key in ("bad-key-one", "bad-key-two"):
+            self.assertEqual(
+                self.client.post(
+                    "/api/admin/verify", headers={"x-admin-key": key}
+                ).status_code,
+                401,
+            )
+        response = self.client.post(
+            "/api/admin/verify", headers={"x-admin-key": "test-admin-password"}
+        )
+        self.assertEqual(response.status_code, 429)
+        response = self.client.post(
+            "/api/admin/verify",
+            headers={"x-admin-key": "test-admin-password"},
+            environ_overrides={"REMOTE_ADDR": "198.51.100.2"},
+        )
+        self.assertEqual(response.status_code, 200)
+
+    def test_admin_verification_does_not_consume_mutation_budget(self):
+        self.make_app(RATELIMIT_APPLICATION="100 per minute")
+        for _ in range(2):
+            response = self.client.post(
+                "/api/admin/verify", headers={"x-admin-key": "test-admin-password"}
+            )
+            self.assertEqual(response.status_code, 200)
+        for _ in range(2):
+            self.assertEqual(self.client.post("/api/folders").status_code, 401)
+        self.assertEqual(self.client.post("/api/folders").status_code, 429)
+
+    def test_health_and_frontend_remain_available_after_api_limit(self):
+        self.exhaust_api()
+        with self.app.app_context():
+            engine = db.engine
+
+        def reject_database_work(*_args, **_kwargs):
+            raise AssertionError("Exempt health/frontend request queried the database")
+
+        event.listen(engine, "before_cursor_execute", reject_database_work)
+        try:
+            for _ in range(10):
+                for method in ("GET", "HEAD"):
+                    response = self.client.open("/health", method=method)
+                    self.assertEqual(response.status_code, 200)
+                    self.assertEqual(response.headers["Cache-Control"], "no-store")
+                    self.assertNotIn("X-RateLimit-Limit", response.headers)
+                    if method == "GET":
+                        self.assertEqual(response.json, {"status": "ok"})
+                    else:
+                        self.assertEqual(response.data, b"")
+            for path in ("/", "/js/app.js", "/css/styles.css"):
+                with self.client.get(path) as response:
+                    self.assertEqual(response.status_code, 200)
+            # Throttling must happen before a database query and remain HTTP 429.
+            self.assertEqual(self.client.get("/api/folders").status_code, 429)
+        finally:
+            event.remove(engine, "before_cursor_execute", reject_database_work)
+
+    def test_cover_images_remain_available_after_api_limit(self):
+        with self.app.app_context():
+            image = Image(content_type="image/png", data=b"test-cover-image")
+            db.session.add(image)
+            db.session.commit()
+            image_id = image.id
