--- /dev/null
+++ 2/fanpage/rate_limits.py
@@ -0,0 +1,17 @@
+"""Client identity for rate limiting at the public Render/Cloudflare edge."""
+
+from ipaddress import ip_address
+
+from flask import current_app, request
+
+
+def client_ip() -> str:
+    # Render's public web traffic passes through Cloudflare. Only trust this
+    # header when that deployment boundary has explicitly been enabled.
+    if current_app.config["RATELIMIT_TRUST_CLOUDFLARE"]:
+        forwarded = request.headers.get("CF-Connecting-IP", "").strip()
+        try:
+            return str(ip_address(forwarded))
+        except ValueError:
+            pass
+    return request.remote_addr or "unknown"
