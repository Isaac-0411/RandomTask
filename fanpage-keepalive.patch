+
+    def test_trusted_cloudflare_clients_have_independent_limits(self):
+        self.make_app(RATELIMIT_TRUST_CLOUDFLARE=True)
+        proxy = {"REMOTE_ADDR": "10.0.0.1"}
+        self.exhaust_api(
+            headers={"CF-Connecting-IP": "198.51.100.1"},
